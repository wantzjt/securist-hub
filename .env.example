# Public hostname (no scheme)
VITE_PUBLIC_HOSTNAME=secur.ist

# Dual-forge identity (org lanes only — never personal handles on UI)
VITE_PUBLIC_GITHUB_ORG=securist
VITE_PUBLIC_HF_ORG=securist

# Optional server-only: read-only PAT for higher public org event rate limits
# NEVER commit real tokens. Set in Vercel Project → Settings → Environment Variables.
# GITHUB_TOKEN=

# —— Decision Graph store (server-only) ——
# memory | seed  = local/demo only (default)
# postgres       = durable; requires ALL of:
#   DATABASE_URL (or SECURIST_DATABASE_URL)
#   SECURIST_DEFAULT_TENANT_ID  — REQUIRED for current public surface
#     (server functions read without a per-request tenant; missing value
#      fails at startup with missing_default_tenant_id, not mid-request)
# SECURIST_GRAPH_STORE=memory
# DATABASE_URL=
# SECURIST_DEFAULT_TENANT_ID=public-demo
# See docs/INFRA-AUDIT-POSTGRES.md — do not commit credentials.
