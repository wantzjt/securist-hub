{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secur.ist/schemas/repository-system-graph.v1.json",
  "title": "Securist repository system graph",
  "type": "object",
  "required": [
    "schemaVersion",
    "canonicalProductAuthority",
    "sourceDocuments",
    "coverageRoots",
    "checks",
    "invariants",
    "nodes",
    "edges",
    "valueLoop"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "canonicalProductAuthority": { "type": "string", "minLength": 1 },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "coverageRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "extensions", "excludePrefixes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "excludePrefixes": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["automated", "human"] },
          "command": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "enforcedBy"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[0-9]{3}$" },
          "statement": { "type": "string", "minLength": 1 },
          "enforcedBy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "authority",
          "status",
          "paths",
          "dependsOn",
          "invariants",
          "verifiedBy"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "verifiedBy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "valueLoop": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "stage", "node", "status"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "node": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
